generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String   @id @default(uuid())
  username         String
  email            String   @unique
  passwordHash     String   @map("password")
  createdAt        DateTime @default(now())
  role             Role     @default(USER)
  refreshTokenHash String?

  @@map("user")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
}
