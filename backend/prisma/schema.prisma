generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String   @map("password")
  createdAt    DateTime @default(now())

  @@map("user")
}
