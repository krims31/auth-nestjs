{
  "$schema": "https://vercel.sh",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "node",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build",
      "entrypoint": "main.js"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
